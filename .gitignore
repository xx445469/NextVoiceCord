# ============================================================
#  機密：絕對不要 commit
# ============================================================
# macOS 檔案系統不分大小寫，各種寫法都擋
claude.env
CLAUDE.ENV
Claude.env
*.env
!*.env.example
youtubetoken.txt

# ============================================================
#  執行期產生的設定與狀態（只擋根目錄，不影響 resources）
# ============================================================
/config.txt
/serversettings.json
/*.json
/*.txt
!/README.txt
/Playlists/
/logs/
*.lock
*.log
.slashcommands.hash

# 例外：專案資源必須進版控（i18n 語言檔、controller 模板等）
!src/main/resources/**/*.json
!src/main/resources/**/*.txt
!src/test/resources/**/*.json

# ============================================================
#  建置產物
# ============================================================
/target/
/test/
dependency-reduced-pom.xml
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ============================================================
#  IDE
# ============================================================
/.idea/
/.vscode/
/.cursor/
/nbproject/
nb*.xml
*.iml
*.iws

# ============================================================
#  OS
# ============================================================
.DS_Store
Thumbs.db

# Backups of config.txt. The bot writes these itself every time a setting is saved
# from the desktop window or the web panel, and they carry the Discord token verbatim.
# /config.txt alone does not match them, which is how one nearly got committed.
config.txt.bak
config.txt.bak.*
*.bak
/userlanguages.json
